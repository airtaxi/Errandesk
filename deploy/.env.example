# Errandesk server configuration. Copy this file to .env and adjust it.
# Leave a value empty to use its default. Secret values marked "_FILE supported" can instead be
# supplied as NAME_FILE=/path/to/file, whose trimmed content is used; never set both NAME and NAME_FILE.

# Host port that Docker Compose publishes the server on (Compose only; not read by the server). Default 8080.
ERRANDESK_PUBLISHED_PORT=

# Required. MongoDB connection string (mongodb:// or mongodb+srv://). "mongodb" is the Compose service name. _FILE supported.
ERRANDESK_MONGODB_CONNECTION_STRING=mongodb://mongodb:27017

# MongoDB database name. Default errandesk.
ERRANDESK_MONGODB_DATABASE=

# Required. Key that signs access tokens, at least 32 bytes. Generate one with: openssl rand -base64 48. _FILE supported.
ERRANDESK_JWT_SIGNING_KEY=

# Lifetime of access tokens in minutes. Default 15.
ERRANDESK_ACCESS_TOKEN_MINUTES=

# Lifetime of refresh tokens in days. Default 30.
ERRANDESK_REFRESH_TOKEN_DAYS=

# Port the server listens on inside the container, on all interfaces. Default 8080.
ERRANDESK_HTTP_PORT=

# Minimum log level: Trace, Debug, Information, Warning, Error, Critical or None. Default Information.
ERRANDESK_LOG_LEVEL=

# Who may register once the first user (the administrator) exists: open, invite or disabled. Default invite.
ERRANDESK_REGISTRATION_MODE=

# Base URL of an OpenAI-compatible API used by the assistant. Default https://api.openai.com/v1.
ERRANDESK_AI_ENDPOINT=

# API key for the assistant endpoint. Required with the default OpenAI endpoint, optional for custom endpoints. _FILE supported.
ERRANDESK_AI_API_KEY=

# Chat model name. The assistant is enabled only when this is set.
ERRANDESK_AI_MODEL=

# Android push: set all three FCM values or none. Firebase project ID.
ERRANDESK_FCM_PROJECT_ID=

# Android push: service account email (client_email in the service account JSON).
ERRANDESK_FCM_CLIENT_EMAIL=

# Android push: service account private key in PEM format (private_key in the service account JSON). _FILE supported.
ERRANDESK_FCM_PRIVATE_KEY=

# iOS push: set all four APNs values or none. Apple developer team ID.
ERRANDESK_APNS_TEAM_ID=

# iOS push: ID of the APNs authentication key (.p8).
ERRANDESK_APNS_KEY_ID=

# iOS push: content of the .p8 key. _FILE supported.
ERRANDESK_APNS_PRIVATE_KEY=

# iOS push: bundle ID of the iOS app, sent as the apns-topic header.
ERRANDESK_APNS_BUNDLE_ID=

# iOS push: APNs environment, production or sandbox. Default production.
ERRANDESK_APNS_ENVIRONMENT=

# Microsoft To Do import: client ID of a Microsoft Entra app registration with "Allow public client flows" enabled and the delegated Microsoft Graph permission Tasks.Read. Import is enabled only when this is set.
ERRANDESK_MICROSOFT_GRAPH_CLIENT_ID=

# Microsoft To Do import: Microsoft Entra tenant used for sign-in: common (personal, work and school accounts), consumers, organizations, or a tenant ID. Default common.
ERRANDESK_MICROSOFT_GRAPH_TENANT=
