# Copy this file to errandesk-release.env in the local root:
#   scripts\local\errandesk-release.env inside the app repository
#   the build repository root in a separate build repository
#
# Relative paths resolve from the local root.
ERRANDESK_ANDROID_KEYSTORE=ks
ERRANDESK_ANDROID_KEY_ALIAS=errandesk
ERRANDESK_ANDROID_KEYSTORE_PASSWORD_FILE=secrets/android-keystore-password.txt
ERRANDESK_ANDROID_KEY_PASSWORD_FILE=secrets/android-key-password.txt
# If the keystore uses one password for both, remove the keystore password line.
# The key password file is then used for both.
# ERRANDESK_ANDROID_KEYSTORE_PASSWORD=change-me
# ERRANDESK_ANDROID_KEY_PASSWORD=change-me
ERRANDESK_ANDROID_GOOGLE_SERVICES_JSON=google-services.json
ERRANDESK_ANDROID_OUTPUT_DIRECTORY=.
