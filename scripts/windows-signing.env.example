# Copy this file to windows-signing.env in the local root:
#   scripts\local\windows-signing.env inside the app repository
#   the build repository root in a separate build repository
#
# Relative paths resolve from the local root. The first build creates the certificate
# and the password file when they do not exist.
ERRANDESK_WINDOWS_PFX=Errandesk-Windows.pfx
ERRANDESK_WINDOWS_PFX_PASSWORD_FILE=secrets/windows-pfx-password.txt
# ERRANDESK_WINDOWS_PFX_PASSWORD=change-me
ERRANDESK_WINDOWS_CER=Errandesk-Windows.cer
