<UserControl
    x:Class="Errandesk.Client.Views.AssistantView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Errandesk.Client.Models"
    xmlns:views="using:Errandesk.Client.Views"
    AutomationProperties.AutomationId="AssistantView">

    <UserControl.Resources>
        <DataTemplate x:Key="ToolActivityTemplate" x:DataType="models:ToolActivityModel">
            <Grid MinHeight="32" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ProgressRing
                    Width="14"
                    Height="14"
                    VerticalAlignment="Center"
                    IsActive="{x:Bind IsRunning, Mode=OneWay}"
                    Visibility="{x:Bind IsRunning, Mode=OneWay}" />
                <FontIcon
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE73E;"
                    Visibility="{x:Bind IsSucceededIconVisible, Mode=OneWay}" />
                <FontIcon
                    FontSize="14"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Glyph="&#xE783;"
                    Visibility="{x:Bind IsFailedIconVisible, Mode=OneWay}" />

                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="ToolActivityTextBlock"
                    Style="{StaticResource MetadataTextBlockStyle}"
                    Text="{x:Bind DisplayText}" />

                <Button
                    x:Uid="ToolUndoButton"
                    Grid.Column="2"
                    Padding="8,2"
                    AutomationProperties.AutomationId="ToolUndoButton"
                    Click="OnToolUndoButtonClicked"
                    Visibility="{x:Bind CanUndo, Mode=OneWay}" />
                <TextBlock
                    x:Uid="ToolUndoneTextBlock"
                    Grid.Column="2"
                    AutomationProperties.AutomationId="ToolUndoneTextBlock"
                    Style="{StaticResource MetadataTextBlockStyle}"
                    Visibility="{x:Bind IsUndone, Mode=OneWay}" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ErrorText, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind HasError, Mode=OneWay}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ApprovalTemplate" x:DataType="models:ApprovalModel">
            <Border
                Padding="12"
                AutomationProperties.AutomationId="ApprovalCard"
                AutomationProperties.Name="{x:Bind PromptText}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock
                        AutomationProperties.AutomationId="ApprovalPromptTextBlock"
                        Text="{x:Bind PromptText}"
                        TextWrapping="Wrap" />
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="{x:Bind AreDecisionButtonsVisible, Mode=OneWay}">
                        <Button
                            x:Uid="ApproveButton"
                            AutomationProperties.AutomationId="ApproveButton"
                            Click="OnApproveButtonClicked"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            x:Uid="DenyButton"
                            AutomationProperties.AutomationId="DenyButton"
                            Click="OnDenyButtonClicked" />
                    </StackPanel>
                    <TextBlock
                        AutomationProperties.AutomationId="ApprovalStatusTextBlock"
                        Style="{StaticResource MetadataTextBlockStyle}"
                        Text="{x:Bind StatusText, Mode=OneWay}"
                        Visibility="{x:Bind IsDecided, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MessageTemplate" x:DataType="models:ChatMessageModel">
            <Grid>
                <Border
                    MaxWidth="320"
                    Padding="12,8"
                    HorizontalAlignment="Right"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="8"
                    Visibility="{x:Bind IsUser}">
                    <TextBlock
                        AutomationProperties.AutomationId="UserMessageTextBlock"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind Text}"
                        TextWrapping="Wrap" />
                </Border>

                <StackPanel Spacing="8" Visibility="{x:Bind IsAssistant}">
                    <ItemsControl ItemTemplate="{StaticResource ToolActivityTemplate}" ItemsSource="{x:Bind ToolActivities}" />
                    <views:MarkdownView
                        AutomationProperties.AutomationId="AssistantMessageMarkdownView"
                        Markdown="{x:Bind Text, Mode=OneWay}"
                        Visibility="{x:Bind HasText, Mode=OneWay}" />
                    <ProgressRing
                        x:Uid="AssistantReplyProgressRing"
                        Width="16"
                        Height="16"
                        HorizontalAlignment="Left"
                        IsActive="{x:Bind IsStreaming, Mode=OneWay}"
                        Visibility="{x:Bind IsStreaming, Mode=OneWay}" />
                    <TextBlock
                        x:Uid="AssistantStoppedTextBlock"
                        AutomationProperties.AutomationId="AssistantStoppedTextBlock"
                        Style="{StaticResource MetadataTextBlockStyle}"
                        Visibility="{x:Bind IsStopped, Mode=OneWay}" />
                    <Grid ColumnSpacing="8" Visibility="{x:Bind HasError, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Margin="0,2,0,0"
                            VerticalAlignment="Top"
                            FontSize="14"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Glyph="&#xE783;" />
                        <TextBlock
                            Grid.Column="1"
                            AutomationProperties.AutomationId="AssistantReplyErrorTextBlock"
                            Text="{x:Bind ErrorText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </Grid>
                    <ItemsControl ItemTemplate="{StaticResource ApprovalTemplate}" ItemsSource="{x:Bind Approvals}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ConversationTemplate" x:DataType="models:ConversationItemModel">
            <Grid
                MinHeight="48"
                Padding="0,4"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind DisplayTitle, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource MetadataTextBlockStyle}" Text="{x:Bind UpdatedText, Mode=OneWay}" />
                </StackPanel>

                <Button
                    x:Uid="DeleteConversationButton"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="DeleteConversationButton"
                    Click="OnDeleteConversationButtonClicked"
                    Style="{StaticResource IconButtonStyle}">
                    <ToolTipService.ToolTip>
                        <ToolTip x:Uid="DeleteConversationToolTip" />
                    </ToolTipService.ToolTip>
                    <FontIcon FontSize="16" Glyph="&#xE74D;" />
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="16,8,8,0" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="AssistantTitleTextBlock"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind ViewModel.HeaderTitle, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />

            <ToggleButton
                x:Uid="AssistantConversationsButton"
                Grid.Column="1"
                Width="36"
                Height="36"
                Padding="0"
                AutomationProperties.AutomationId="AssistantConversationsButton"
                Command="{x:Bind ViewModel.ToggleConversationListCommand}"
                IsChecked="{x:Bind ViewModel.IsConversationListOpen, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsChatOrListVisible, Mode=OneWay}">
                <ToolTipService.ToolTip>
                    <ToolTip x:Uid="AssistantConversationsToolTip" />
                </ToolTipService.ToolTip>
                <FontIcon FontSize="16" Glyph="&#xE81C;" />
            </ToggleButton>

            <Button
                x:Uid="AssistantNewConversationButton"
                Grid.Column="2"
                AutomationProperties.AutomationId="AssistantNewConversationButton"
                Command="{x:Bind ViewModel.NewConversationCommand}"
                Style="{StaticResource IconButtonStyle}"
                Visibility="{x:Bind ViewModel.IsChatOrListVisible, Mode=OneWay}">
                <ToolTipService.ToolTip>
                    <ToolTip x:Uid="AssistantNewConversationToolTip" />
                </ToolTipService.ToolTip>
                <FontIcon FontSize="16" Glyph="&#xE710;" />
            </Button>

            <Button
                x:Uid="AssistantCloseButton"
                Grid.Column="3"
                AutomationProperties.AutomationId="AssistantCloseButton"
                Click="OnAssistantCloseButtonClicked"
                Style="{StaticResource IconButtonStyle}">
                <ToolTipService.ToolTip>
                    <ToolTip x:Uid="AssistantCloseToolTip" />
                </ToolTipService.ToolTip>
                <FontIcon FontSize="16" Glyph="&#xE711;" />
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Padding="16,0">
            <ProgressBar
                AutomationProperties.AutomationId="AssistantProgressBar"
                IsIndeterminate="True"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            <InfoBar
                AutomationProperties.AutomationId="AssistantErrorInfoBar"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.IsErrorVisible, Mode=TwoWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error"
                Visibility="{x:Bind ViewModel.IsErrorVisible, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button
                        x:Uid="RetryButton"
                        AutomationProperties.AutomationId="AssistantRetryButton"
                        Command="{x:Bind ViewModel.LoadCommand}"
                        Visibility="{x:Bind ViewModel.IsRetryVisible, Mode=OneWay}" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <StackPanel
            Grid.Row="2"
            MaxWidth="360"
            Padding="16"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="AssistantUnavailablePanel"
            Spacing="12"
            Visibility="{x:Bind ViewModel.IsAiUnavailable, Mode=OneWay}">
            <TextBlock
                x:Uid="AssistantUnavailableTitleTextBlock"
                HorizontalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <TextBlock
                x:Uid="AssistantUnavailableTextBlock"
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="AssistantUnavailableTextBlock"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button
                x:Uid="AssistantCheckAgainButton"
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="AssistantCheckAgainButton"
                Command="{x:Bind ViewModel.LoadCommand}" />
        </StackPanel>

        <Grid Grid.Row="2" Visibility="{x:Bind ViewModel.IsConversationListVisible, Mode=OneWay}">
            <ListView
                x:Name="ConversationListView"
                x:Uid="ConversationListView"
                Padding="4,0"
                AutomationProperties.AutomationId="ConversationListView"
                IsItemClickEnabled="True"
                ItemClick="OnConversationListViewItemClicked"
                ItemTemplate="{StaticResource ConversationTemplate}"
                ItemsSource="{x:Bind ViewModel.Conversations}"
                SelectionMode="None" />
            <TextBlock
                x:Uid="EmptyConversationListTextBlock"
                Margin="16"
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="EmptyConversationListTextBlock"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.IsEmptyConversationListVisible, Mode=OneWay}" />
        </Grid>

        <Grid
            Grid.Row="2"
            RowSpacing="8"
            Visibility="{x:Bind ViewModel.IsChatVisible, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer
                x:Name="MessagesScrollViewer"
                AutomationProperties.AutomationId="AssistantMessagesScrollViewer"
                HorizontalScrollMode="Disabled"
                SizeChanged="OnMessagesScrollViewerSizeChanged"
                ViewChanged="OnMessagesScrollViewerViewChanged">
                <ItemsControl
                    x:Name="MessagesItemsControl"
                    Margin="16,0,16,8"
                    AutomationProperties.AutomationId="AssistantMessagesItemsControl"
                    ItemTemplate="{StaticResource MessageTemplate}"
                    ItemsSource="{x:Bind ViewModel.Messages}"
                    SizeChanged="OnMessagesItemsControlSizeChanged">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="16" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock
                x:Uid="AssistantEmptyTextBlock"
                MaxWidth="320"
                Margin="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="AssistantEmptyTextBlock"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.IsEmptyConversationVisible, Mode=OneWay}" />

            <Grid
                Grid.Row="1"
                Padding="16,0,16,16"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="MessageTextBox"
                    x:Uid="AssistantMessageTextBox"
                    MaxHeight="160"
                    AcceptsReturn="True"
                    AutomationProperties.AutomationId="AssistantMessageTextBox"
                    LostFocus="OnMessageTextBoxLostFocus"
                    PreviewKeyDown="OnMessageTextBoxPreviewKeyDown"
                    PreviewKeyUp="OnMessageTextBoxPreviewKeyUp"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />

                <Button
                    x:Uid="AssistantSendButton"
                    Grid.Column="1"
                    Width="36"
                    Height="32"
                    Padding="0"
                    VerticalAlignment="Bottom"
                    AutomationProperties.AutomationId="AssistantSendButton"
                    Click="OnAssistantSendOrStopButtonClicked"
                    Command="{x:Bind ViewModel.SendCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsSendButtonVisible, Mode=OneWay}">
                    <ToolTipService.ToolTip>
                        <ToolTip x:Uid="AssistantSendToolTip" />
                    </ToolTipService.ToolTip>
                    <FontIcon FontSize="14" Glyph="&#xE724;" />
                </Button>

                <Button
                    x:Uid="AssistantStopButton"
                    Grid.Column="1"
                    Width="36"
                    Height="32"
                    Padding="0"
                    VerticalAlignment="Bottom"
                    AutomationProperties.AutomationId="AssistantStopButton"
                    Click="OnAssistantSendOrStopButtonClicked"
                    Command="{x:Bind ViewModel.StopCommand}"
                    Visibility="{x:Bind ViewModel.IsReplying, Mode=OneWay}">
                    <ToolTipService.ToolTip>
                        <ToolTip x:Uid="AssistantStopToolTip" />
                    </ToolTipService.ToolTip>
                    <FontIcon FontSize="14" Glyph="&#xE71A;" />
                </Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
