<Page
    x:Class="Errandesk.Client.Pages.SignInPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <Grid Padding="24" VerticalAlignment="Center">
            <StackPanel MaxWidth="400" Spacing="16">
                <StackPanel Spacing="4">
                    <TextBlock
                        x:Uid="SignInTitleTextBlock"
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource TitleTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        AutomationProperties.AutomationId="SignInServerAddressTextBlock"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.ServerAddressText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <InfoBar
                    AutomationProperties.AutomationId="SignInErrorInfoBar"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.IsErrorVisible, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Error"
                    Visibility="{x:Bind ViewModel.IsErrorVisible, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button
                            x:Uid="RetrySignInButton"
                            AutomationProperties.AutomationId="RetrySignInButton"
                            Command="{x:Bind ViewModel.RetryRestoreCommand}"
                            Visibility="{x:Bind ViewModel.IsRestoreRetryVisible, Mode=OneWay}" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <TextBox
                    x:Uid="UserNameTextBox"
                    AutomationProperties.AutomationId="UserNameTextBox"
                    IsSpellCheckEnabled="False"
                    IsTextPredictionEnabled="False"
                    Text="{x:Bind ViewModel.UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <PasswordBox
                    x:Uid="PasswordBox"
                    AutomationProperties.AutomationId="PasswordBox"
                    KeyDown="OnPasswordBoxKeyDown"
                    Password="{x:Bind ViewModel.Password, Mode=TwoWay}" />

                <Button
                    x:Uid="SignInButton"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="SignInButton"
                    Command="{x:Bind ViewModel.SignInCommand}"
                    Style="{StaticResource AccentButtonStyle}" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <HyperlinkButton
                        x:Uid="CreateAccountLinkButton"
                        AutomationProperties.AutomationId="CreateAccountLinkButton"
                        Command="{x:Bind ViewModel.ShowSignUpCommand}"
                        Visibility="{x:Bind ViewModel.IsSignUpAvailable, Mode=OneWay}" />
                    <HyperlinkButton
                        x:Uid="ChangeServerLinkButton"
                        AutomationProperties.AutomationId="ChangeServerLinkButton"
                        Command="{x:Bind ViewModel.ChangeServerCommand}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
