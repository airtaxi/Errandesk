<Page
    x:Class="Errandesk.Client.Pages.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Errandesk.Client.Views"
    Loaded="OnPageLoaded"
    Unloaded="OnPageUnloaded">

    <Page.Resources>
        <!--  The open task count next to a smart list or list: secondary text without the badge fill.  -->
        <Style x:Key="OpenTaskCountInfoBadgeStyle" TargetType="InfoBadge">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <NavigationView
        x:Name="ShellNavigationView"
        AutomationProperties.AutomationId="ShellNavigationView"
        CompactModeThresholdWidth="720"
        DisplayModeChanged="OnShellNavigationViewDisplayModeChanged"
        ExpandedModeThresholdWidth="1008"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="True"
        ItemInvoked="OnShellNavigationViewItemInvoked"
        PaneClosed="OnShellNavigationViewPaneClosed"
        PaneClosing="OnShellNavigationViewPaneClosing"
        PaneOpened="OnShellNavigationViewPaneOpened"
        PaneOpening="OnShellNavigationViewPaneOpening"
        PaneTitle="{x:Bind ViewModel.UserDisplayName, Mode=OneWay}"
        SelectionChanged="OnShellNavigationViewSelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem
                x:Name="MyDayNavigationItem"
                x:Uid="MyDayNavigationItem"
                AutomationProperties.AutomationId="MyDayNavigationItem">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE706;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                x:Name="ImportantNavigationItem"
                x:Uid="ImportantNavigationItem"
                AutomationProperties.AutomationId="ImportantNavigationItem">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE734;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                x:Name="PlannedNavigationItem"
                x:Uid="PlannedNavigationItem"
                AutomationProperties.AutomationId="PlannedNavigationItem">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE787;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                x:Name="TasksNavigationItem"
                x:Uid="TasksNavigationItem"
                AutomationProperties.AutomationId="TasksNavigationItem">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE80F;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItemSeparator x:Name="ListsSeparator" />
        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <NavigationViewItem
                x:Name="NotesNavigationItem"
                x:Uid="NotesNavigationItem"
                AutomationProperties.AutomationId="NotesNavigationItem">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE70B;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                x:Name="AssistantNavigationItem"
                x:Uid="AssistantNavigationItem"
                AutomationProperties.AutomationId="AssistantNavigationItem"
                SelectsOnInvoked="False">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8F2;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                x:Name="NewListNavigationItem"
                x:Uid="NewListNavigationItem"
                AutomationProperties.AutomationId="NewListNavigationItem"
                SelectsOnInvoked="False">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE710;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <Grid x:Name="ContentGrid" SizeChanged="OnContentGridSizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="MainContentColumn" Width="*" />
                <ColumnDefinition x:Name="AssistantColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <InfoBar
                    AutomationProperties.AutomationId="ShellErrorInfoBar"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.IsErrorVisible, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Error"
                    Visibility="{x:Bind ViewModel.IsErrorVisible, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button
                            x:Uid="RetryButton"
                            AutomationProperties.AutomationId="ShellRetryButton"
                            Click="OnShellRetryButtonClicked" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <InfoBar
                    Title="{x:Bind ViewModel.InAppReminderTitle, Mode=OneWay}"
                    AutomationProperties.AutomationId="InAppReminderInfoBar"
                    AutomationProperties.LiveSetting="Assertive"
                    CloseButtonClick="OnInAppReminderInfoBarCloseButtonClicked"
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.IsInAppReminderVisible, Mode=OneWay}"
                    Message="{x:Bind ViewModel.InAppReminderText, Mode=OneWay}"
                    Severity="Informational"
                    Visibility="{x:Bind ViewModel.IsInAppReminderVisible, Mode=OneWay}">
                    <InfoBar.IconSource>
                        <FontIconSource Glyph="&#xEA8F;" />
                    </InfoBar.IconSource>
                    <InfoBar.ActionButton>
                        <Button
                            x:Uid="OpenReminderTaskButton"
                            AutomationProperties.AutomationId="OpenReminderTaskButton"
                            Click="OnOpenReminderTaskButtonClicked" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>

            <Frame
                x:Name="ContentFrame"
                Grid.Row="1"
                AutomationProperties.AutomationId="ContentFrame"
                Navigated="OnContentFrameNavigated" />

            <Border
                x:Name="AssistantPanel"
                Grid.RowSpan="2"
                Grid.Column="1"
                AutomationProperties.AutomationId="AssistantPanel"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                Visibility="Collapsed">
                <views:AssistantView x:Name="AssistantView" CloseRequested="OnAssistantViewCloseRequested" />
            </Border>
        </Grid>
    </NavigationView>
</Page>
