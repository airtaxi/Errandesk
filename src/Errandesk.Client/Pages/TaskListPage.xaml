<Page
    x:Class="Errandesk.Client.Pages.TaskListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Errandesk.Client.Helpers"
    xmlns:models="using:Errandesk.Client.Models"
    xmlns:views="using:Errandesk.Client.Views"
    KeyboardAcceleratorPlacementMode="Hidden"
    Loaded="OnPageLoaded"
    SizeChanged="OnPageSizeChanged"
    Unloaded="OnPageUnloaded">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="N"
            Invoked="OnNewTaskKeyboardAcceleratorInvoked"
            Modifiers="Control" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <DataTemplate x:Key="TaskRowTemplate" x:DataType="models:TaskItemModel">
            <Grid
                MinHeight="52"
                Padding="0,6"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox
                    MinWidth="0"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="TaskCompletionCheckBox"
                    AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                    Click="OnTaskCompletionCheckBoxClicked"
                    IsChecked="{x:Bind IsCompleted, Mode=OneWay}" />

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        Text="{x:Bind Title, Mode=OneWay}"
                        TextDecorations="{x:Bind helpers:XamlFunctions.GetTitleDecorations(IsCompleted), Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <views:WrapPanel
                        HorizontalSpacing="12"
                        VerticalSpacing="2"
                        Visibility="{x:Bind HasMetadata, Mode=OneWay}">
                        <TextBlock
                            Style="{StaticResource MetadataTextBlockStyle}"
                            Text="{x:Bind ListName, Mode=OneWay}"
                            Visibility="{x:Bind IsListNameVisible, Mode=OneWay}" />
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4"
                            Visibility="{x:Bind IsMyDayLabelVisible, Mode=OneWay}">
                            <FontIcon Glyph="&#xE706;" Style="{StaticResource MetadataIconStyle}" />
                            <TextBlock x:Uid="MyDayMetadataTextBlock" Style="{StaticResource MetadataTextBlockStyle}" />
                        </StackPanel>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4"
                            Visibility="{x:Bind HasSteps, Mode=OneWay}">
                            <FontIcon Glyph="&#xE9D5;" Style="{StaticResource MetadataIconStyle}" />
                            <TextBlock Style="{StaticResource MetadataTextBlockStyle}" Text="{x:Bind StepsProgressText, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4"
                            Visibility="{x:Bind HasDueDate, Mode=OneWay}">
                            <FontIcon Glyph="&#xE787;" Style="{StaticResource MetadataIconStyle}" />
                            <TextBlock Style="{StaticResource MetadataTextBlockStyle}" Text="{x:Bind DueDateText, Mode=OneWay}" />
                        </StackPanel>
                        <FontIcon
                            AutomationProperties.AutomationId="TaskRecurrenceIndicator"
                            AutomationProperties.Name="{x:Bind RecurrenceText, Mode=OneWay}"
                            Glyph="&#xE8EE;"
                            Style="{StaticResource MetadataIconStyle}"
                            ToolTipService.ToolTip="{x:Bind RecurrenceText, Mode=OneWay}"
                            Visibility="{x:Bind HasRecurrence, Mode=OneWay}" />
                        <StackPanel
                            AutomationProperties.AutomationId="TaskReminderIndicator"
                            Orientation="Horizontal"
                            Spacing="4"
                            Visibility="{x:Bind HasReminder, Mode=OneWay}">
                            <FontIcon Glyph="&#xEA8F;" Style="{StaticResource MetadataIconStyle}" />
                            <TextBlock Style="{StaticResource MetadataTextBlockStyle}" Text="{x:Bind RowReminderText, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4"
                            Visibility="{x:Bind HasLinkedNotes, Mode=OneWay}">
                            <FontIcon Glyph="&#xE70B;" Style="{StaticResource MetadataIconStyle}" />
                            <TextBlock Style="{StaticResource MetadataTextBlockStyle}" Text="{x:Bind LinkedNoteCountText, Mode=OneWay}" />
                        </StackPanel>
                    </views:WrapPanel>
                </StackPanel>

                <Button
                    Grid.Column="2"
                    AutomationProperties.AutomationId="TaskImportanceButton"
                    AutomationProperties.Name="{x:Bind helpers:XamlFunctions.GetImportanceButtonText(IsImportant), Mode=OneWay}"
                    Click="OnTaskImportanceButtonClicked"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind helpers:XamlFunctions.GetImportanceButtonText(IsImportant), Mode=OneWay}">
                    <Grid>
                        <FontIcon
                            FontSize="16"
                            Glyph="&#xE734;"
                            Visibility="{x:Bind helpers:XamlFunctions.VisibleWhenFalse(IsImportant), Mode=OneWay}" />
                        <FontIcon
                            FontSize="16"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE735;"
                            Visibility="{x:Bind IsImportant, Mode=OneWay}" />
                    </Grid>
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CompletedSectionRowTemplate" x:DataType="models:CompletedSectionModel">
            <Button
                Padding="8,6"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                AutomationProperties.AutomationId="CompletedSectionButton"
                Background="Transparent"
                BorderThickness="0"
                Click="OnCompletedSectionButtonClicked">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="12" Glyph="{x:Bind helpers:XamlFunctions.GetCompletedSectionGlyph(IsExpanded), Mode=OneWay}" />
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind HeaderText, Mode=OneWay}" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <helpers:TaskRowTemplateSelector
            x:Key="TaskRowTemplateSelector"
            CompletedSectionTemplate="{StaticResource CompletedSectionRowTemplate}"
            TaskTemplate="{StaticResource TaskRowTemplate}" />
    </Page.Resources>

    <Grid x:Name="LayoutGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ListColumn" Width="*" />
            <ColumnDefinition x:Name="DetailColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <Grid
            x:Name="ListPanel"
            Padding="24,16,24,0"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="2">
                    <TextBlock
                        AutomationProperties.AutomationId="TaskListTitleTextBlock"
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        AutomationProperties.AutomationId="MyDayDateTextBlock"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.HeaderDateText, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsHeaderDateVisible, Mode=OneWay}" />
                    <TextBlock
                        AutomationProperties.AutomationId="ListSharingTextBlock"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.SharingText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind ViewModel.IsSharingTextVisible, Mode=OneWay}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button
                        x:Uid="ShareListButton"
                        AutomationProperties.AutomationId="ShareListButton"
                        Click="OnShareListButtonClicked"
                        Style="{StaticResource IconButtonStyle}"
                        Visibility="{x:Bind ViewModel.IsShareVisible, Mode=OneWay}">
                        <ToolTipService.ToolTip>
                            <ToolTip x:Uid="ShareListToolTip" />
                        </ToolTipService.ToolTip>
                        <FontIcon FontSize="16" Glyph="&#xE8FA;" />
                    </Button>
                    <Button
                        x:Uid="ListMembersButton"
                        AutomationProperties.AutomationId="ListMembersButton"
                        Click="OnShareListButtonClicked"
                        Style="{StaticResource IconButtonStyle}"
                        Visibility="{x:Bind ViewModel.IsMembersVisible, Mode=OneWay}">
                        <ToolTipService.ToolTip>
                            <ToolTip x:Uid="ListMembersToolTip" />
                        </ToolTipService.ToolTip>
                        <FontIcon FontSize="16" Glyph="&#xE716;" />
                    </Button>
                    <Button
                        x:Uid="ListActionsButton"
                        AutomationProperties.AutomationId="ListActionsButton"
                        Style="{StaticResource IconButtonStyle}"
                        Visibility="{x:Bind ViewModel.IsListActionsVisible, Mode=OneWay}">
                        <ToolTipService.ToolTip>
                            <ToolTip x:Uid="ListActionsToolTip" />
                        </ToolTipService.ToolTip>
                        <FontIcon FontSize="16" Glyph="&#xE712;" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem
                                    x:Uid="RenameListMenuItem"
                                    AutomationProperties.AutomationId="RenameListMenuItem"
                                    Command="{x:Bind ViewModel.RenameListCommand}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8AC;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    x:Uid="DeleteListMenuItem"
                                    AutomationProperties.AutomationId="DeleteListMenuItem"
                                    Command="{x:Bind ViewModel.DeleteListCommand}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74D;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>

            <InfoBar
                Grid.Row="1"
                AutomationProperties.AutomationId="TaskListErrorInfoBar"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.IsErrorVisible, Mode=TwoWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error"
                Visibility="{x:Bind ViewModel.IsErrorVisible, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button
                        x:Uid="RetryButton"
                        AutomationProperties.AutomationId="TaskListRetryButton"
                        Command="{x:Bind ViewModel.RefreshCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="NewTaskTextBox"
                    x:Uid="NewTaskTextBox"
                    AutomationProperties.AutomationId="NewTaskTextBox"
                    KeyDown="OnNewTaskTextBoxKeyDown"
                    MaxLength="500"
                    Text="{x:Bind ViewModel.NewTaskTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    x:Uid="AddTaskButton"
                    Grid.Column="1"
                    VerticalAlignment="Stretch"
                    AutomationProperties.AutomationId="AddTaskButton"
                    Command="{x:Bind ViewModel.AddTaskCommand}">
                    <ToolTipService.ToolTip>
                        <ToolTip x:Uid="AddTaskToolTip" />
                    </ToolTipService.ToolTip>
                    <FontIcon FontSize="16" Glyph="&#xE710;" />
                </Button>
            </Grid>

            <ListView
                x:Name="TasksListView"
                Grid.Row="3"
                Padding="0,0,0,24"
                AutomationProperties.AutomationId="TasksListView"
                ItemTemplateSelector="{StaticResource TaskRowTemplateSelector}"
                ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                SelectionChanged="OnTasksListViewSelectionChanged"
                SelectionMode="Single">
                <ListView.Header>
                    <StackPanel Spacing="4">
                        <Border
                            Margin="0,0,0,8"
                            Padding="16,12,8,16"
                            AutomationProperties.AutomationId="MorningBriefingPanel"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{x:Bind ViewModel.IsBriefingVisible, Mode=OneWay}">
                            <Grid ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    x:Uid="MorningBriefingPanelTitleTextBlock"
                                    VerticalAlignment="Center"
                                    AutomationProperties.HeadingLevel="Level2"
                                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <Button
                                    x:Uid="DismissBriefingButton"
                                    Grid.Column="1"
                                    AutomationProperties.AutomationId="DismissBriefingButton"
                                    Command="{x:Bind ViewModel.DismissBriefingCommand}"
                                    Style="{StaticResource IconButtonStyle}">
                                    <ToolTipService.ToolTip>
                                        <ToolTip x:Uid="DismissBriefingToolTip" />
                                    </ToolTipService.ToolTip>
                                    <FontIcon FontSize="16" Glyph="&#xE711;" />
                                </Button>

                                <views:MarkdownView
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Margin="0,0,8,0"
                                    AutomationProperties.AutomationId="MorningBriefingMarkdownView"
                                    Markdown="{x:Bind ViewModel.BriefingText, Mode=OneWay}" />

                                <Button
                                    x:Uid="OpenBriefingInAssistantButton"
                                    Grid.Row="2"
                                    AutomationProperties.AutomationId="OpenBriefingInAssistantButton"
                                    Command="{x:Bind ViewModel.OpenBriefingInAssistantCommand}" />
                            </Grid>
                        </Border>

                        <TextBlock
                            x:Uid="EmptyTaskListTextBlock"
                            Margin="0,24,0,0"
                            HorizontalAlignment="Center"
                            AutomationProperties.AutomationId="EmptyTaskListTextBlock"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.IsEmptyStateVisible, Mode=OneWay}" />
                    </StackPanel>
                </ListView.Header>
            </ListView>
        </Grid>

        <Border
            x:Name="DetailPanel"
            Grid.Column="1"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0"
            Visibility="Collapsed">
            <views:TaskDetailView x:Name="TaskDetailView" ViewModel="{x:Bind ViewModel.Detail}" />
        </Border>
    </Grid>
</Page>
