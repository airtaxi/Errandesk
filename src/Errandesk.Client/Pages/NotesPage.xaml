<Page
    x:Class="Errandesk.Client.Pages.NotesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Errandesk.Client.Models"
    xmlns:views="using:Errandesk.Client.Views"
    KeyboardAcceleratorPlacementMode="Hidden"
    Loaded="OnPageLoaded"
    SizeChanged="OnPageSizeChanged"
    Unloaded="OnPageUnloaded">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="N"
            Invoked="OnNewNoteKeyboardAcceleratorInvoked"
            Modifiers="Control" />
    </Page.KeyboardAccelerators>

    <Grid x:Name="LayoutGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ListColumn" Width="*" />
            <ColumnDefinition x:Name="EditorColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <Grid
            x:Name="ListPanel"
            Padding="24,16,24,0"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Uid="NotesTitleTextBlock"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="NotesTitleTextBlock"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}" />

                <Button
                    Grid.Column="1"
                    AutomationProperties.AutomationId="NewNoteButton"
                    Click="OnNewNoteButtonClicked">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock x:Uid="NewNoteButtonTextBlock" />
                    </StackPanel>
                </Button>
            </Grid>

            <InfoBar
                Grid.Row="1"
                AutomationProperties.AutomationId="NotesErrorInfoBar"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.IsErrorVisible, Mode=TwoWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error"
                Visibility="{x:Bind ViewModel.IsErrorVisible, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button
                        x:Uid="RetryButton"
                        AutomationProperties.AutomationId="NotesRetryButton"
                        Command="{x:Bind ViewModel.RefreshCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Grid
                Grid.Row="2"
                ColumnSpacing="8"
                RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <AutoSuggestBox
                    x:Uid="NoteSearchBox"
                    AutomationProperties.AutomationId="NoteSearchBox"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <AutoSuggestBox.QueryIcon>
                        <FontIcon FontSize="14" Glyph="&#xE721;" />
                    </AutoSuggestBox.QueryIcon>
                </AutoSuggestBox>

                <ComboBox
                    x:Uid="TagFilterComboBox"
                    Grid.Column="1"
                    Width="132"
                    AutomationProperties.AutomationId="TagFilterComboBox"
                    ItemsSource="{x:Bind ViewModel.TagFilterOptions}"
                    SelectedIndex="{x:Bind ViewModel.SelectedTagFilterIndex, Mode=TwoWay}" />
            </Grid>

            <Grid Grid.Row="3">
                <TextBlock
                    Margin="0,24,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    AutomationProperties.AutomationId="EmptyNotesTextBlock"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.EmptyStateText, Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.IsEmptyStateVisible, Mode=OneWay}" />

                <ListView
                    x:Name="NotesListView"
                    Padding="0,0,0,24"
                    AutomationProperties.AutomationId="NotesListView"
                    ItemsSource="{x:Bind ViewModel.Notes}"
                    SelectionChanged="OnNotesListViewSelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:NoteItemModel">
                            <Grid
                                Padding="0,8"
                                ColumnSpacing="8"
                                RowSpacing="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind DisplayTitle, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <FontIcon
                                    x:Uid="PinnedNoteIcon"
                                    Grid.Column="1"
                                    Glyph="&#xE840;"
                                    Style="{StaticResource MetadataIconStyle}"
                                    Visibility="{x:Bind IsPinned, Mode=OneWay}" />

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    MaxLines="2"
                                    Style="{StaticResource MetadataTextBlockStyle}"
                                    Text="{x:Bind Excerpt, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind HasExcerpt, Mode=OneWay}" />

                                <StackPanel
                                    Grid.Row="2"
                                    Grid.ColumnSpan="2"
                                    Orientation="Horizontal"
                                    Spacing="12">
                                    <TextBlock Style="{StaticResource MetadataTextBlockStyle}" Text="{x:Bind UpdatedText, Mode=OneWay}" />
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        Visibility="{x:Bind HasTags, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE8EC;" Style="{StaticResource MetadataIconStyle}" />
                                        <TextBlock Style="{StaticResource MetadataTextBlockStyle}" Text="{x:Bind TagsText, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <Border
            x:Name="EditorPanel"
            Grid.Column="1"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0">
            <Grid>
                <views:NoteEditorView
                    x:Name="NoteEditorView"
                    ViewModel="{x:Bind ViewModel.Editor}"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="NoNoteSelectedTextBlock"
                    x:Uid="NoNoteSelectedTextBlock"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="NoNoteSelectedTextBlock"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</Page>
