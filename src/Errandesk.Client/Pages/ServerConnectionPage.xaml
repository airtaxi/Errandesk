<Page
    x:Class="Errandesk.Client.Pages.ServerConnectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <Grid Padding="24" VerticalAlignment="Center">
            <StackPanel MaxWidth="480" Spacing="16">
                <TextBlock
                    x:Uid="ServerConnectionTitleTextBlock"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}"
                    TextWrapping="Wrap" />

                <TextBox
                    x:Uid="ServerAddressTextBox"
                    AutomationProperties.AutomationId="ServerAddressTextBox"
                    InputScope="Url"
                    IsSpellCheckEnabled="False"
                    KeyDown="OnServerAddressTextBoxKeyDown"
                    Text="{x:Bind ViewModel.ServerAddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <InfoBar
                    x:Uid="InsecureConnectionInfoBar"
                    AutomationProperties.AutomationId="InsecureConnectionInfoBar"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.IsInsecureAddressWarningVisible, Mode=OneWay}"
                    Severity="Warning"
                    Visibility="{x:Bind ViewModel.IsInsecureAddressWarningVisible, Mode=OneWay}" />

                <Button
                    x:Uid="ConnectButton"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="ConnectButton"
                    Command="{x:Bind ViewModel.ConnectCommand}"
                    Style="{StaticResource AccentButtonStyle}" />

                <InfoBar
                    x:Uid="ConnectionErrorInfoBar"
                    AutomationProperties.AutomationId="ConnectionErrorInfoBar"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.IsErrorVisible, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Error"
                    Visibility="{x:Bind ViewModel.IsErrorVisible, Mode=OneWay}" />

                <StackPanel
                    AutomationProperties.AutomationId="ServerInfoPanel"
                    Spacing="16"
                    Visibility="{x:Bind ViewModel.IsServerInfoVisible, Mode=OneWay}">
                    <InfoBar
                        x:Uid="ConnectedInfoBar"
                        AutomationProperties.AutomationId="ConnectedInfoBar"
                        IsClosable="False"
                        IsOpen="True"
                        Severity="Success" />

                    <Grid ColumnSpacing="24" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Uid="ServerVersionLabelTextBlock" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            Grid.Column="1"
                            AutomationProperties.AutomationId="ServerVersionTextBlock"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.ServerVersionText, Mode=OneWay}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            x:Uid="RegistrationLabelTextBlock"
                            Grid.Row="1"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="RegistrationTextBlock"
                            Text="{x:Bind ViewModel.RegistrationText, Mode=OneWay}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            x:Uid="AssistantLabelTextBlock"
                            Grid.Row="2"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="AssistantTextBlock"
                            Text="{x:Bind ViewModel.AssistantText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </Grid>

                    <Button
                        x:Uid="ContinueButton"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="ContinueButton"
                        Command="{x:Bind ViewModel.ContinueCommand}"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
