<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/task_widget_sheet_scrim"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/TaskWidgetScrim"
  android:fitsSystemWindows="true">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@drawable/task_widget_sheet_background"
    android:clickable="true"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <TextView
      android:id="@+id/task_widget_add_view"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="@color/TaskWidgetSecondaryText"
      android:textSize="13sp" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <EditText
        android:id="@+id/task_widget_add_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:hint="@string/TaskWidgetAddHint"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="textCapSentences"
        android:maxLines="1"
        android:textColor="@color/TaskWidgetPrimaryText"
        android:textColorHint="@color/TaskWidgetSecondaryText"
        android:textSize="16sp" />

      <ImageButton
        android:id="@+id/task_widget_add_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/task_widget_button_background"
        android:contentDescription="@string/TaskWidgetAdd"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/task_widget_add"
        android:tint="@color/TaskWidgetAccent" />
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
