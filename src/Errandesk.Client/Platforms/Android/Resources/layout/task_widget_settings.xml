<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/task_widget_sheet_scrim"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/TaskWidgetScrim"
  android:fitsSystemWindows="true">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@drawable/task_widget_sheet_background"
    android:clickable="true"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="16dp"
    android:paddingEnd="24dp"
    android:paddingBottom="16dp">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="56dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:labelFor="@+id/task_widget_settings_opacity"
        android:text="@string/TaskWidgetOpacity"
        android:textColor="@color/TaskWidgetPrimaryText"
        android:textSize="16sp" />

      <SeekBar
        android:id="@+id/task_widget_settings_opacity"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1" />

      <TextView
        android:id="@+id/task_widget_settings_opacity_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:minWidth="48dp"
        android:textColor="@color/TaskWidgetSecondaryText"
        android:textSize="16sp" />
    </LinearLayout>

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:text="@string/TaskWidgetFontSize"
      android:textColor="@color/TaskWidgetPrimaryText"
      android:textSize="16sp" />

    <RadioGroup
      android:id="@+id/task_widget_settings_font_size"
      android:layout_width="match_parent"
      android:layout_height="48dp"
      android:orientation="horizontal">

      <RadioButton
        android:id="@+id/task_widget_settings_font_size_small"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:text="@string/TaskWidgetFontSizeSmall"
        android:textColor="@color/TaskWidgetPrimaryText" />

      <RadioButton
        android:id="@+id/task_widget_settings_font_size_normal"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:text="@string/TaskWidgetFontSizeNormal"
        android:textColor="@color/TaskWidgetPrimaryText" />

      <RadioButton
        android:id="@+id/task_widget_settings_font_size_large"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:text="@string/TaskWidgetFontSizeLarge"
        android:textColor="@color/TaskWidgetPrimaryText" />
    </RadioGroup>

    <androidx.appcompat.widget.SwitchCompat
      android:id="@+id/task_widget_settings_completed_tasks"
      android:layout_width="match_parent"
      android:layout_height="56dp"
      android:layout_marginTop="8dp"
      android:text="@string/TaskWidgetShowCompleted"
      android:textColor="@color/TaskWidgetPrimaryText"
      android:textSize="16sp" />
  </LinearLayout>
</FrameLayout>
