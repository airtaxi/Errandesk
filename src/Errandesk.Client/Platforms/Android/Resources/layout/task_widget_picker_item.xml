<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="56dp"
  android:background="@drawable/task_widget_picker_item_background"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:paddingStart="24dp"
  android:paddingEnd="24dp">

  <ImageView
    android:id="@+id/task_widget_picker_item_icon"
    android:layout_width="24dp"
    android:layout_height="24dp"
    android:importantForAccessibility="no"
    android:tint="@color/TaskWidgetIcon" />

  <TextView
    android:id="@+id/task_widget_picker_item_title"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="20dp"
    android:layout_weight="1"
    android:ellipsize="end"
    android:maxLines="1"
    android:textColor="@color/TaskWidgetPrimaryText"
    android:textSize="16sp" />
</LinearLayout>
