<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Network status changes start a synchronization as soon as the server can be reached again. -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- Reminder notifications: posting them, exact reminder alarms, and setting the alarms again after a restart. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <!-- App updates: opening the system package installer for a downloaded update APK. -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <!-- Assistant dictation opens the speech recognition screen of the system. -->
  <queries>
    <intent>
      <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
    </intent>
  </queries>
  <!-- Self-hosted servers on a local network are often reached over plain HTTP. -->
  <application android:allowBackup="true" android:supportsRtl="true" android:usesCleartextTraffic="true">
    <!-- Shares downloaded update APKs with the system package installer. -->
    <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.updates" android:exported="false" android:grantUriPermissions="true">
      <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/app_update_file_paths" />
    </provider>
  </application>
</manifest>
